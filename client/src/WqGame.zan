using System;
using System.IO;
using Gui;
using Game.Board;
using Game.Kit;
using Game.Foundation.Gui;

public class WqGame {
    Canvas c;
    WqProfile prof;
    Rng rng;

    // 棋盘与规则交给共享包：Game.Board.GoBoard
    // （落子/提子/自杀禁手/打劫禁着/气数/中国规则数子）。
    GoBoard go;    int mode;  // 0 game, 1..3 drills
    int moves;
    int lastSq;
    int winner;  // 1 player, 2 ai
    int scoreB;
    int scoreW;
    int aiThinkAt;
    bool aiTurn;
    int mouseX;
    int mouseY;
    int toastAt;
    string toastText;
    int placedAt;
    List<WqParticle> parts;
    List<WqPopup> pops;
    string menuBg;  // asset paths (null = 画布回退画法)
    string titlePath;
    string boardPath;
    string blackPath;
    string whitePath;
    string menuBg2;  // 手绘美术资产（新名，绝不覆盖旧素材）
    string playBg;
    string boardArt;
    string blackPath2;
    string whitePath2;
    bool texTried;
    bool demo;
    int demoAt;

    static int N() { return 9; }
    // 竖屏（舞台高>宽：手机竖屏或竖长窗口）参照手机棋类布局自适应：
    // 9 路棋盘水平居中放大（格距 92），顶部对手条 + 回合徽标，底部
    // 停一手按钮行；横屏维持"左棋盘 + 右信息栏"原布局。
    static bool Portrait() { return WqGame.VW() < WqGame.VH(); }
    static int Cell() {
        if (!WqGame.Portrait()) { return 64; }
        // 竖屏自适应：格距收进当前舞台宽（盘面 8c+76 ≤ VW-20），
        // 否则 92 格距在 720 宽的延展舞台上棋盘会左右出界被裁。
        int c = (WqGame.VW() - 96) / 8;
        if (c > 92) { c = 92; }
        if (c < 24) { c = 24; }
        return c;
    }
    static int BX() { return (WqGame.VW() - 8 * WqGame.Cell()) / 2; }
    static int BY() {
        if (!WqGame.Portrait()) { return 104; }
        // 顶部条(0..150) + 徽标带(到 250)之下、底部按钮行(高 120)之上居中
        return 250 + (WqGame.VH() - 250 - 170 - 8 * WqGame.Cell()) / 2;
    }
    // 视口按宿主舞台每帧延展（宽窗多看宽度）：VW/VH 是当前帧的舞台
    // 逻辑尺寸，帧首在 SyncStage 更新——布局锚定它即可满铺任意窗口，
    // 否则长轴超出的部分就是宿主 margin 底色的空条。
    static int VW() { return vw > 0 ? vw : 1280; }
    static int VH() { return vh > 0 ? vh : 720; }

    // 帧首对齐宿主延展舞台（GuiHost.Render 回调开头调用）。
    void SyncStage(GuiHost host) {
        WqGame.vw = host.StageWidth();
        WqGame.vh = host.StageHeight();
    }
    static int vw;
    static int vh;

    static WqGame Create(GuiHost h) {
        WqGame g = new WqGame();
        g.prof = WqProfile.Load();
        g.rng = Rng.Seed((long)Window.GetTickMs() + 24680135);
        g.mouseX = 640;
        g.mouseY = 360;
        g.parts = new List<WqParticle>();
        g.pops = new List<WqPopup>();
        g.toastAt = -9999;
        g.demo = File.Exists("weiqi_demo.txt");
        return g;
    }

    void EnsureTex() {
        if (this.texTried) { return; }
        this.texTried = true;
        this.menuBg = WqGame.FindAsset("assets/menu_bg.png");
        this.titlePath = WqGame.FindAsset("assets/title.png");
        this.boardPath = WqGame.FindAsset("assets/board_wood.png");
        this.blackPath = WqGame.FindAsset("assets/stone_black.png");
        this.whitePath = WqGame.FindAsset("assets/stone_white.png");
        this.menuBg2 = WqGame.FindAsset("assets/menu_bg2.png");
        this.playBg = WqGame.FindAsset("assets/play_bg.png");
        this.boardArt = WqGame.FindAsset("assets/board_wood2.png");
        this.blackPath2 = WqGame.FindAsset("assets/stone_black2.png");
        this.whitePath2 = WqGame.FindAsset("assets/stone_white2.png");
    }
    static string FindAsset(string path) {
        string p = Assets.Find(path);
        if (!File.Exists(p)) { return null; }
        return p;
    }

    // 全出血 cover：居中裁剪贴满舞台（长短边都铺满，不留 letterbox 条）。
    static void BlitCover(Canvas c, string path, int dw, int dh) {
        int iw = Canvas.ImageWidth(path);
        int ih = Canvas.ImageHeight(path);
        if (iw <= 0 || ih <= 0) { return; }
        int sw = iw;
        int sh = sw * dh / dw;
        if (sh > ih) { sh = ih; sw = sh * dw / dh; }
        string src = CDraw.BlitSource(c, path);
        if (src == null) { return; }
        c.BlitImage(src, CDraw.MapX(CDraw.originX), CDraw.MapY(CDraw.originY),
                    CDraw.MapW(dw), CDraw.MapW(dh),
                    (iw - sw) / 2, (ih - sh) / 2, sw, sh);
    }

    // ----- feedback --------------------------------------------------------

    void Toast(string t, int now) { this.toastText = t; this.toastAt = now; }
    void AddPop(int px, int py, string t, int now, int cr, int cg, int cb) {
        if (this.pops.Count > 14) { this.pops.RemoveAt(0); }
        WqPopup p = new WqPopup();
        p.x = px; p.y = py; p.text = t; p.bornAt = now;
        p.cr = cr; p.cg = cg; p.cb = cb;
        this.pops.Add(p);
    }
    void Burst(int px, int py, int n, int now, int cr, int cg, int cb) {
        if (this.parts.Count > 240) { return; }
        for (int i = 0; i < n; i = i + 1) {
            WqParticle p = new WqParticle();
            p.x = px * 256; p.y = py * 256;
            int a = this.rng.Range(0, 16);
            int spd = 60 + this.rng.Range(0, 160);
            int ux = 0; int uy = 0;
            int q = a % 4;
            if (q == 0) { ux = 256; uy = (a / 4 - 2) * 128; }
            if (q == 1) { ux = -256; uy = (a / 4 - 2) * 128; }
            if (q == 2) { uy = 256; ux = (a / 4 - 2) * 128; }
            if (q == 3) { uy = -256; ux = (a / 4 - 2) * 128; }
            p.vx = ux * spd / 256;
            p.vy = uy * spd / 256;
            p.bornAt = now;
            p.cr = cr; p.cg = cg; p.cb = cb;
            this.parts.Add(p);
        }
    }

    // ----- setup -----------------------------------------------------------

    void Put(int x, int y, int c) { this.go.Cells[y * WqGame.N() + x] = c; }
    void StartGame(int mode, int now) {
        this.go = new GoBoard(WqGame.N());        this.mode = mode;
        this.moves = 0;
        this.lastSq = -1;
        this.winner = 0;
        this.scoreB = 0;
        this.scoreW = 0;
        this.aiTurn = false;
        this.parts = new List<WqParticle>();
        this.pops = new List<WqPopup>();
        this.toastAt = -9999;
        if (mode == 1) {
            // 征子：顺势连续紧气追杀气尽之子。
            this.Put(2, 3, 1); this.Put(3, 2, 1);
            this.Put(3, 3, 2);
            this.Toast("死活题·征子：黑先，叫吃到底提掉白子", now);
        } else if (mode == 2) {
            // 直三杀：聚三破眼与点杀定式。
            this.Put(2, 1, 2); this.Put(3, 1, 2); this.Put(4, 1, 2); this.Put(5, 1, 2); this.Put(6, 1, 2);
            this.Put(2, 2, 2); this.Put(6, 2, 2);
            this.Put(2, 3, 2); this.Put(3, 3, 2); this.Put(4, 3, 2); this.Put(5, 3, 2); this.Put(6, 3, 2);
            this.Put(1, 1, 1); this.Put(1, 2, 1); this.Put(1, 3, 1);
            this.Put(2, 0, 1); this.Put(3, 0, 1); this.Put(4, 0, 1); this.Put(5, 0, 1); this.Put(6, 0, 1);
            this.Put(7, 1, 1); this.Put(7, 2, 1); this.Put(7, 3, 1);
            this.Put(2, 4, 1); this.Put(3, 4, 1); this.Put(4, 4, 1); this.Put(5, 4, 1); this.Put(6, 4, 1);
            this.Toast("死活题·直三杀：点在要害，白不得两眼", now);
        } else if (mode == 3) {
            this.Put(5, 6, 1); this.Put(6, 5, 1);
            this.Put(6, 6, 2);
            this.Toast("死活题·关门吃：一步关门，白子无路", now);
        } else {
            this.Toast("黑先，围地多者胜（贴七目）", now);
        }
        if (this.demo) { this.demoAt = now + 500; }
    }

    static string DrillName(int m) {
        if (m == 1) { return "征子"; }
        if (m == 2) { return "直三杀"; }
        return "关门吃";
    }
    static int DrillTarget(int m) {
        if (m == 2) { return 8; }
        return 1;
    }

    // ----- rules -----------------------------------------------------------

    int At(int x, int y) { return this.go.At(x, y); }

    // 连通块气数（唯一空点计数）—— 规则在包里。
    int Group(int x, int y, List<int> outSq) { return this.go.Group(x, y, outSq); }

    // 落子：规则（占位/禁着/自杀/提子/打劫）由包判定，
    // 这里只把"提掉了哪几颗"翻译成画面特效。
    int TryPlay(int x, int y, int c, int now) {
        List<int> taken = new List<int>();
        int captured = this.go.Play(x, y, c, taken);
        if (captured < 0) { return -1; }
        int n = WqGame.N();
        for (int i = 0; i < taken.Count; i = i + 1) {
            int sq = taken[i];
            int px = WqGame.BX() + (sq % n) * WqGame.Cell();
            int py = WqGame.BY() + (sq / n) * WqGame.Cell();
            this.Burst(px, py, 6, now, 255, 200, 110);
        }
        return captured;
    }

    // 无副作用试探落子演算（包负责保存/还原棋盘与禁着）。
    int Probe(int x, int y, int c) { return this.go.Probe(x, y, c); }


    // 子空皆地目数（中国规则，贴七目）—— 规则在包里。
    void Score() {
        GoScore sc = this.go.Score(7.0);
        this.scoreB = sc.Black;
        this.scoreW = sc.White + 7;
    }

    void EndByScore(int now) {
        this.Score();
        if (this.scoreB > this.scoreW) { this.Win(1, now); } else { this.Win(2, now); }
    }

    void Win(int who, int now) {
        this.winner = who;
        if (who == 1) {
            int gain = 15;
            if (this.mode > 0) { gain = 18; this.prof.drills = this.prof.drills + 1; }
            this.prof.pts = this.prof.pts + gain;
            this.prof.wins = this.prof.wins + 1;
            this.prof.streak = this.prof.streak + 1;
            if (this.prof.streak > this.prof.bestStreak) { this.prof.bestStreak = this.prof.streak; }
            this.Burst(640, 300, 60, now, 255, 210, 100);
        } else {
            this.prof.losses = this.prof.losses + 1;
            this.prof.streak = 0;
            this.prof.pts = this.prof.pts - 5;
            if (this.prof.pts < 0) { this.prof.pts = 0; }
        }
        this.prof.Save();
    }

    void Place(int x, int y, int c, int now) {
        int n = WqGame.N();
        int captured = this.TryPlay(x, y, c, now);
        if (captured < 0) { return; }
        this.moves = this.moves + 1;
        this.lastSq = y * n + x;
        this.placedAt = now;
        int sx = WqGame.BX() + x * WqGame.Cell();
        int sy = WqGame.BY() + y * WqGame.Cell();
        if (captured > 0) {
            this.AddPop(sx, sy - 28, "提 " + captured + " 子", now, 255, 205, 110);
            if (captured >= 3) { this.Toast("大块提子！痛快", now); }
        }
        if (this.mode > 0 && c == 1 && this.go.CapturedByBlack >= WqGame.DrillTarget(this.mode)) {
            this.Win(1, now);
            return;
        }
        this.aiTurn = (c == 1);
        // AI 思考延迟走设置（快 / 适中 / 从容三档），再叠一点随机更像人。
        if (this.aiTurn) { this.aiThinkAt = now + WqSettings.AiDelayMs() + this.rng.Range(0, 450); }
    }

    void PlayerPass(int now) {
        if (this.aiTurn || this.winner != 0) { return; }
        this.go.Pass(GoBoard.Black);
        this.moves = this.moves + 1;
        this.Toast("你选择停一手", now);
        if (this.go.IsOverByPasses()) { this.EndByScore(now); return; }
        this.aiTurn = true;
        this.aiThinkAt = now + WqSettings.AiDelayMs();
    }

    // ----- AI --------------------------------------------------------------

    int NeighborCount(int x, int y, int c) {
        int k = 0;
        for (int d = 0; d < 8; d = d + 1) {
            int dx = d % 3 - 1;
            int dy = d / 3 - 1;
            if (this.At(x + dx, y + dy) == c) { k = k + 1; }
        }
        return k;
    }

    int AiScoreMove(int x, int y) {
        int cap = this.Probe(x, y, 2);
        if (cap < 0) { return -1000000; }
        int v = this.rng.Range(0, 14);
        v = v + cap * 260;
        // 试探落子气数，避免自紧气送吃（包里一次探测给全信息）。
        GoProbe pr = this.go.ProbeMove(x, y, 2);
        int libs = pr.Liberties;
        // 解救己方濒危棋子策略。
        int rescued = 0;
        if (libs >= 2 && pr.GroupSize > 1) { rescued = 1; }
        if (libs <= 1 && cap == 0) { v = v - 700; }
        v = v + libs * 22;
        // 叫吃紧气进攻策略。
        for (int d = 0; d < 4; d = d + 1) {
            int tx = x; int ty = y;
            if (d == 0) { tx = x + 1; }
            if (d == 1) { tx = x - 1; }
            if (d == 2) { ty = y + 1; }
            if (d == 3) { ty = y - 1; }
            if (this.At(tx, ty) == 1) {
                List<int> g = new List<int>();
                int gl = this.Group(tx, ty, g);
                if (gl == 2) { v = v + 90; }
                if (gl == 1) { v = v + 240; }
            } else if (this.At(tx, ty) == 2) {
                List<int> g = new List<int>();
                int gl = this.Group(tx, ty, g);
                if (gl == 1) { v = v + 320 * rescued; }
            }
        }
        // 布局形态权重偏好。
        v = v + this.NeighborCount(x, y, 2) * 8;
        v = v + this.NeighborCount(x, y, 1) * 12;
        if (this.mode == 0 && this.moves < 12) {
            int cx = x - 4; int cy = y - 4;
            if (cx < 0) { cx = -cx; }
            if (cy < 0) { cy = -cy; }
            v = v + (4 - cx) * 6 + (4 - cy) * 6;
        }
        return v;
    }

    void AiMove(int now) {
        int n = WqGame.N();
        int bestV = -1000000;
        int bestX = -1; int bestY = -1;
        for (int y = 0; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                if (this.At(x, y) == 0) {
                    int v = this.AiScoreMove(x, y);
                    if (v > bestV) { bestV = v; bestX = x; bestY = y; }
                }
            }
        }
        // 无有效落子点时弃着过牌。
        int threshold = -999999;
        if (this.mode == 0 && this.moves > 30) { threshold = 40; }
        if (bestX < 0 || bestV < threshold) {
            this.go.Pass(GoBoard.White);
            this.moves = this.moves + 1;
            this.Toast("白棋停一手", now);
            this.aiTurn = false;
            if (this.go.IsOverByPasses()) { this.EndByScore(now); }
            return;
        }
        this.Place(bestX, bestY, 2, now);
        this.aiTurn = false;
    }

    // ----- input -----------------------------------------------------------

    // 对局内输入（停一手按钮与落子；场景切换由 WqPlayScene 处理）。
    void OnDownPlay(int cx, int cy, int now) {
        // pass button（竖屏 = 底部按钮行）
        if (WqGame.Portrait()) {
            int vw = WqGame.VW();
            int by = WqGame.VH() - 120;
            if (!this.aiTurn && this.winner == 0
                && CDraw.PointIn(cx, cy, vw / 2 - 210, by, 420, 64)) { this.PlayerPass(now); return; }
        } else if (CDraw.PointIn(cx, cy, 770, 560, 200, 56) && !this.aiTurn) { this.PlayerPass(now); return; }
        if (this.aiTurn || this.winner != 0) { return; }
        int c = WqGame.Cell();
        int gx = (cx - WqGame.BX() + c / 2) / c;
        int gy = (cy - WqGame.BY() + c / 2) / c;
        int n = WqGame.N();
        if (gx < 0 || gy < 0 || gx >= n || gy >= n) { return; }
        if (this.At(gx, gy) != 0) { return; }
        if (this.Probe(gx, gy, 1) < 0) { this.Toast("此处不能落子", now); return; }
        this.Place(gx, gy, 1, now);
    }

    void Tick(int now) {
        if (this.aiTurn && now >= this.aiThinkAt) {
            this.AiMove(now);
            this.demoAt = now + 420;
        }
        if (this.demo && !this.aiTurn && now >= this.demoAt) {
            this.DemoMove(now);
        }
    }

    void DemoMove(int now) {
        int n = WqGame.N();
        int bestV = -1000000;
        int bestX = -1; int bestY = -1;
        for (int y = 0; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                if (this.At(x, y) == 0) {
                    int cap = this.Probe(x, y, 1);
                    if (cap >= 0) {
                        int v = cap * 260 + this.NeighborCount(x, y, 2) * 14
                            + this.NeighborCount(x, y, 1) * 8 + this.rng.Range(0, 60);
                        if (v > bestV) { bestV = v; bestX = x; bestY = y; }
                    }
                }
            }
        }
        if (bestX < 0 || this.moves > 52) { this.PlayerPass(now); return; }
        this.Place(bestX, bestY, 1, now);
    }

    // ----- rendering -------------------------------------------------------

    void DrawAmbient() {
        this.EnsureTex();
        int vw = WqGame.VW();
        int vh = WqGame.VH();
        if (this.playBg != null) {
            // 对局底：整幅 cover + 轻压暗，两处暖光晕提棋室氛围。
            WqGame.BlitCover(this.c, this.playBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(150, 18, 10, 7));
            this.c.FillRadial(CDraw.MapX(vw / 3), CDraw.MapY(vh / 3), CDraw.MapW(430),
                              CDraw.Argb(255, 220, 150, 80), 16);
            this.c.FillRadial(CDraw.MapX(vw * 2 / 3), CDraw.MapY(vh * 4 / 5), CDraw.MapW(360),
                              CDraw.Argb(255, 220, 140, 70), 12);
        } else if (this.menuBg != null) {
            CKitUi.Backdrop(this.c, this.menuBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(190, 18, 14, 10));
            CDraw.FillCircle(this.c, vw / 3, vh / 3, 420, 255, 190, 110, 14);
        }
        CFx.Vignette(this.c, vw, vh, 70);
    }

    void DrawBoard(int now) {
        int n = WqGame.N();
        int c = WqGame.Cell();
        int x0 = WqGame.BX();
        int y0 = WqGame.BY();
        int span = (n - 1) * c;
        // 漆木桌 + 真实榧木棋盘面（先投影后落板，再描金边）
        if (this.boardArt != null) {
            CFx.ShadowRect(this.c, x0 - 38, y0 - 30, span + 76, span + 76, 18, 22, 0, 0, 0, 130);
            CDraw.BlitImage(this.c, this.boardArt, x0 - 38, y0 - 38, span + 76, span + 76);
            CDraw.FillRect(this.c, x0 - 38, y0 - 38, span + 76, span + 76,
                CDraw.Argb(18, 255, 226, 170));
            CFx.Ring(this.c, x0 - 38, y0 - 38, span + 76, span + 76, 12, 1, 40, 20, 8, 150);
        } else {
            CDraw.RoundRectFill(this.c, x0 - 48, y0 - 48, span + 96, span + 96, 14, 60, 38, 20, 255);
            if (this.boardPath != null) {
                CDraw.BlitImage(this.c, this.boardPath, x0 - 40, y0 - 40, span + 80, span + 80);
                CDraw.FillRect(this.c, x0 - 40, y0 - 40, span + 80, span + 80,
                    CDraw.Argb(18, 255, 220, 160));
            } else {
                CDraw.RoundRectFill(this.c, x0 - 40, y0 - 40, span + 80, span + 80, 10, 214, 168, 106, 255);
            }
        }
        int grid = CDraw.Argb(240, 40, 24, 12);
        for (int i = 0; i < n; i = i + 1) {
            CDraw.FillRect(this.c, x0, y0 + i * c - 1, span, 2, grid);
            CDraw.FillRect(this.c, x0 + i * c - 1, y0, 2, span, grid);
        }
        // 棋盘星位标记坐标。
        CDraw.FillCircle(this.c, x0 + 2 * c, y0 + 2 * c, 4, 40, 24, 12, 240);
        CDraw.FillCircle(this.c, x0 + 6 * c, y0 + 2 * c, 4, 40, 24, 12, 240);
        CDraw.FillCircle(this.c, x0 + 2 * c, y0 + 6 * c, 4, 40, 24, 12, 240);
        CDraw.FillCircle(this.c, x0 + 6 * c, y0 + 6 * c, 4, 40, 24, 12, 240);
        CDraw.FillCircle(this.c, x0 + 4 * c, y0 + 4 * c, 4, 40, 24, 12, 240);
        // stones
        for (int y = 0; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                int v = this.At(x, y);
                if (v > 0) {
                    int sx = x0 + x * c;
                    int sy = y0 + y * c;
                    int rad = c * 27 / 92;
                    bool isLast = this.lastSq == y * n + x;
                    if (isLast) {
                        int age = now - this.placedAt;
                        int grow = rad * 2 / 9;
                        if (age < 220 && age >= 0) { rad = rad - grow + age * grow / 220; }
                        CDraw.FillCircle(this.c, sx, sy, rad + 8, 255, 200, 110, 60);
                    }
                    CDraw.FillCircle(this.c, sx + 2, sy + 4, rad, 30, 18, 8, 90);
                    string stone = this.blackPath2;
                    if (v == 2) { stone = this.whitePath2; }
                    if (stone == null) { stone = this.blackPath; }
                    if (v == 2 && this.whitePath2 == null) { stone = this.whitePath; }
                    if (stone != null) {
                        CDraw.BlitImage(this.c, stone, sx - rad, sy - rad, rad * 2, rad * 2);
                    } else if (v == 1) {
                        CDraw.FillCircle(this.c, sx, sy, rad, 34, 36, 44, 255);
                        CDraw.FillCircle(this.c, sx - 6, sy - 8, rad / 3, 130, 140, 160, 200);
                    } else {
                        CDraw.FillCircle(this.c, sx, sy, rad, 236, 232, 222, 255);
                        CDraw.FillCircle(this.c, sx - 6, sy - 8, rad / 3, 255, 255, 255, 230);
                    }
                    if (isLast) {
                        CDraw.FillCircle(this.c, sx, sy, 5, 255, 90, 90, 220);
                    }
                }
            }
        }
        // ko marker
        if (this.go.KoPoint >= 0) {
            int kx = x0 + (this.go.KoPoint % n) * c;
            int ky = y0 + (this.go.KoPoint / n) * c;
            int km = c * 10 / 92;
            CDraw.RingRect(this.c, kx - km, ky - km, km * 2, km * 2, 2, 220, 90, 80, 200);
        }
        if (this.winner == 0 && !this.aiTurn) {
            int gx = (this.mouseX - x0 + c / 2) / c;
            int gy = (this.mouseY - y0 + c / 2) / c;
            if (gx >= 0 && gy >= 0 && gx < n && gy < n && this.At(gx, gy) == 0) {
                CDraw.FillCircle(this.c, x0 + gx * c, y0 + gy * c, c * 24 / 92, 34, 36, 44, 90);
            }
        }
    }

    void DrawSide(int now) {
        if (WqGame.Portrait()) { this.DrawTopBar(now); return; }
        int px = 720;
        CFx.Card(this.c, px, 66, 492, 588, 16, 40, 28, 16, 30, 20, 12, 226, 186, 128, 90, 1, 0);
        CFx.Rule(this.c, px + 246, 148, 190, 226, 186, 128, 130);
        CText.Draw(this.c, "围棋", px + 36, 96, 5, 240, 224, 195, 255);
        string mn = "九路对弈 · 贴七目";
        if (this.mode > 0) { mn = "死活题 · " + WqGame.DrillName(this.mode); }
        CText.Draw(this.c, mn, px + 36, 170, 2, 255, 216, 152, 255);
        string turn = "轮到你落子";
        int tr = 140; int tg = 220; int tb = 170;
        if (this.aiTurn) { turn = "白棋长考中…"; tr = 255; tg = 214; tb = 150; }
        CText.Draw(this.c, turn, px + 36, 214, 3, tr, tg, tb, 255);
        CText.Draw(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts + " 分", px + 36, 286, 2, 235, 226, 205, 255);
        CText.Draw(this.c, "胜 " + this.prof.wins + " · 负 " + this.prof.losses, px + 36, 326, 2, 200, 192, 172, 255);
        CText.Draw(this.c, "连胜 " + this.prof.streak + " · 最佳 " + this.prof.bestStreak, px + 36, 366, 2, 200, 192, 172, 255);
        CText.Draw(this.c, "你提子 " + this.go.CapturedByBlack + " · 白提子 " + this.go.CapturedByWhite, px + 36, 406, 2, 200, 192, 172, 255);
        if (this.mode > 0) {
            CText.Draw(this.c, "目标：提 " + WqGame.DrillTarget(this.mode) + " 子", px + 36, 446, 2, 255, 205, 130, 255);
        } else {
            CText.Draw(this.c, "第 " + (this.moves + 1) + " 手", px + 36, 446, 2, 200, 192, 172, 255);
        }
        CKitUi.Button(this.c, this.mouseX, this.mouseY, 770, 560, 200, 56, "停一手 (P)", 2, 0);
        CText.Draw(this.c, "Esc 菜单", px + 36, 630, 2, 160, 152, 136, 255);
    }

    // 竖屏对局 HUD：顶部对手条 + 回合徽标（参考手机棋类布局），
    // 底部"停一手"整宽按钮行。
    void DrawTopBar(int now) {
        int vw = WqGame.VW();
        CFx.Card(this.c, 16, 24, vw - 32, 112, 16, 40, 28, 16, 30, 20, 12, 226, 186, 128, 90, 1, 0);
        CText.Draw(this.c, "对手 · 白棋", 40, 44, 3, 240, 224, 195, 255);
        string mn = "九路对弈 · 贴七目";
        if (this.mode > 0) { mn = "死活题 · " + WqGame.DrillName(this.mode); }
        CText.Draw(this.c, mn, 40, 92, 2, 255, 216, 152, 255);
        string turn = "轮到你落子";
        int tr = 140; int tg = 220; int tb = 170;
        if (this.aiTurn) { turn = "白棋长考中…"; tr = 255; tg = 214; tb = 150; }
        CFx.Pill(this.c, vw - 300, 48, 268, 64, 0, 26, 16, 10, 16, 9, 5, 226, 186, 128, 70);
        CText.DrawCentered(this.c, turn, vw - 166, 66, 3, tr, tg, tb, 255);
        CText.Draw(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts + " 分 · 胜 "
            + this.prof.wins + " 负 " + this.prof.losses, 40, 200, 2, 200, 192, 172, 255);
        CText.Draw(this.c, "你提子 " + this.go.CapturedByBlack + " · 白提子 " + this.go.CapturedByWhite
            + " · 第 " + (this.moves + 1) + " 手", 40, 236, 2, 200, 192, 172, 255);
        int by = WqGame.VH() - 120;
        CKitUi.Button(this.c, this.mouseX, this.mouseY, vw / 2 - 210, by, 420, 64, "停一手 (P)", 3, 0);
    }

    void DrawFx(int now) {
        int i = 0;
        while (i < this.parts.Count) {
            WqParticle p = this.parts[i];
            int age = now - p.bornAt;
            if (age > 900) { this.parts.RemoveAt(i); continue; }
            int px = (p.x + p.vx * age / 4) / 256;
            int py = (p.y + p.vy * age / 4) / 256 + age * age / 26000;
            int alpha = 235 - age * 235 / 900;
            CDraw.FillCircle(this.c, px, py, 3, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        i = 0;
        while (i < this.pops.Count) {
            WqPopup p = this.pops[i];
            int age = now - p.bornAt;
            if (age > 1400) { this.pops.RemoveAt(i); continue; }
            int alpha = 255 - age * 255 / 1400;
            CText.DrawCentered(this.c, p.text, p.x, p.y - age / 14, 2, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        if (now - this.toastAt < 2200) {
            CText.DrawCenteredShadow(this.c, this.toastText, WqGame.VW() / 2, WqGame.VH() / 2 - 120, 2, 255, 224, 150, 255);
        }
    }

    void DrawPlay(int now) {
        CDraw.Clear(this.c, WqGame.VW(), WqGame.VH(), CDraw.Argb(255, 30, 22, 14));
        this.DrawAmbient();
        this.DrawBoard(now);
        this.DrawSide(now);
        this.DrawFx(now);
    }

    // 菜单画布层：美术背景 + 标题（模式按钮与战绩行走 WqMenuScene 的 HTML 层）。
    void DrawMenuArt() {
        this.EnsureTex();
        int vw = WqGame.VW();
        int vh = WqGame.VH();
        CDraw.Clear(this.c, vw, vh, CDraw.Argb(255, 24, 18, 12));
        if (this.menuBg2 != null) {
            WqGame.BlitCover(this.c, this.menuBg2, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(110, 18, 10, 6));
        } else {
            CKitUi.Backdrop(this.c, this.menuBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(120, 14, 10, 6));
        }
        CFx.Vignette(this.c, vw, vh, 90);
        if (this.titlePath != null) {
            CDraw.BlitImage(this.c, this.titlePath, vw / 2 - 300, 30, 600, 200);
        } else {
            CText.DrawCenteredShadow(this.c, "围棋", vw / 2, 70, 9, 245, 232, 205, 255);
        }
    }
}

// 主菜单：画布层只画美术背景与标题（WqMenuScene.Render → DrawMenuArt），
// 四个模式按钮与战绩行走 HTML 层；每次进场由 WqPlayScene.OnEnter 开新局。
