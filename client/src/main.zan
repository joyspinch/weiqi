using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class WqApp {
    static void Main() {
        // 手机竖屏：GuiHost 逻辑宽高比定外壳方向（见 xiangqi 同注）。
        SceneRouter router = SceneRouter.CreateFixed("围棋", 720, 1280, 16);
        WqGame g = WqGame.Create(router.Host());
        router.Register("menu", new WqMenuScene(g));
        router.Register("play", new WqPlayScene(g));
        router.Register("over", new WqOverScene(g));
        router.Register("settings", new WqSettingsScene(g));
        // 设置读档一次（Game.Foundation.GameSettings 负责存盘与坏文件回退）。
        WqSettings.Ensure();
        // demo 标记（weiqi_demo.txt）直接进对局自弈供截图/无头验证。
        router.Run(g.demo ? "play" : "menu");
    }
}
